APP_NAME="Done Translations"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=hu
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=hu_HU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Adatbázis: MySQL / MariaDB (helyben és élesben is). Az adatbázist előbb létre kell hozni (lásd README).
# SQLite-tal is működik: DB_CONNECTION=sqlite, a többi DB_ sor törölhető.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=done_translations
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Levelezés. Fejlesztéskor MAIL_MAILER=log: a levelek a storage/logs/laravel.log fájlba kerülnek.
# Élesben a donetranslations.hu saját levelezőszervere (RackForest cPanel), az info@ postafiók jelszavával.
# Próba: php artisan mail:test
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=mail.donetranslations.hu
MAIL_PORT=465
MAIL_USERNAME=info@donetranslations.hu
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@donetranslations.hu"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Ide érkeznek az ajánlatkérések (a fordító e-mail címe)
QUOTE_RECIPIENT_EMAIL=info@donetranslations.hu
# Az ügyfélnek küldött visszaigazolásban jelenik meg
QUOTE_CONTACT_PHONE="+36 30 857 6652"
QUOTE_MAX_FILE_KB=8192

# Admin bejelentkezés érvényessége percben (720 = 12 óra)
SANCTUM_EXPIRATION=720
# Ha a frontend külön domainen fut: a frontend címe (több cím vesszővel)
CORS_ALLOWED_ORIGINS=*

# Google reCAPTCHA v3 (https://www.google.com/recaptcha/admin). A régi WordPress oldal is ezt használta.
# Ha a titkos kulcs üres, az ellenőrzés kikapcsol.
RECAPTCHA_SITE_KEY=6LfjKkgmAAAAAOJHyQVeVfuKWI-mdF9LuBUGEch9
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Az első admin felhasználó (php artisan db:seed --force hozza létre). Jelszó nélkül generál egyet és kiírja.
ADMIN_EMAIL=info@donetranslations.hu
ADMIN_NAME="Szatmáry Máté"
ADMIN_PASSWORD=
